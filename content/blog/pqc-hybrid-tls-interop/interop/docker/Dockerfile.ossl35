# OpenSSL 3.5.x LTS as shipped by Debian 13 (trixie)
FROM debian:trixie
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      openssl libssl-dev gcc libc6-dev tcpdump tshark ethtool iproute2 ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY src/hsprobe.c /src/hsprobe.c
RUN gcc -O2 -o /usr/local/bin/hsprobe /src/hsprobe.c -lssl -lcrypto
